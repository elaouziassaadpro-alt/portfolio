      "name": "ThemeContext.jsx",
      "filePath": "src/contexts/ThemeContext.jsx",
      "summary": "Theme state layer that treats the document's data-theme attribute as an external store, staying consistent with the pre-paint inline script and dark-by-default pre-rendered HTML.",
      "tags": ["context-provider", "theming", "state-management", "hook", "ssr"],
      "complexity": "simple",
      "languageNotes": "useSyncExternalStore with a separate server snapshot avoids hydration mismatches when the saved theme differs from the pre-rendered default."
    },
