      "name": "LanguageContext.jsx",
      "filePath": "src/contexts/LanguageContext.jsx",
      "summary": "React context managing the active language, derived from the URL, with crossfaded switches, history integration, persistence, and document head updates.",
      "tags": ["context-provider", "i18n", "state-management", "hook", "seo"],
      "complexity": "moderate",
      "languageNotes": "A timed flag sequence fades text out before swapping it; setTimeout is deliberately used over requestAnimationFrame because rAF is suspended in background tabs and would leave the page invisible."
    },
    {
      "id": "function:src/contexts/LanguageContext.jsx:LanguageProvider",
