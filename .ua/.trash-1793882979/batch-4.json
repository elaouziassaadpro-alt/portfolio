      "name": "App.jsx",
      "filePath": "src/App.jsx",
      "summary": "Root React component module that assembles the single-page portfolio from its navbar, sections, technology marquee, and footer, shared by both the client and server render entries.",
      "tags": ["entry-point", "component", "layout", "page-composition"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/App.jsx:App",
      "type": "function",
      "name": "App",
      "filePath": "src/App.jsx",
      "lineRange": [16, 70],
      "summary": "Lays out the page with a skip link, navbar, main sections, and footer, wiring in the active-section and glow-pointer hooks. It crossfades the whole page during language changes, keeping the filter at none at rest so the fixed nav stays anchored.",
      "tags": ["component", "layout", "i18n", "accessibility", "page-composition"],
      "complexity": "moderate",
      "languageNotes": "Any CSS filter value other than none makes an element the containing block for position: fixed descendants, which is why the wrapper resets to none when idle."
    },
    {
      "id": "file:src/components/Marquee.jsx",
      "type": "file",
      "name": "Marquee.jsx",
      "filePath": "src/components/Marquee.jsx",
      "summary": "Reusable presentational component module providing the endlessly scrolling strip of technologies shown beneath the hero.",
      "tags": ["component", "presentational", "animation", "accessibility"],
      "complexity": "simple"
    },
    {
      "id": "function:src/components/Marquee.jsx:Marquee",
      "type": "function",
      "name": "Marquee",
      "filePath": "src/components/Marquee.jsx",
      "lineRange": [3, 22],
      "summary": "Renders a labelled region containing the item list twice so a -50% slide loops seamlessly, hiding the duplicate copy from screen readers.",
      "tags": ["component", "presentational", "animation", "accessibility"],
      "complexity": "simple"
    },
    {
      "id": "file:src/hooks/useActiveSection.js",
      "type": "file",
      "name": "useActiveSection.js",
      "filePath": "src/hooks/useActiveSection.js",
      "summary": "Custom React hook module that tracks which page section is currently in view so the navbar can highlight its matching link.",
      "tags": ["hook", "navigation", "scroll-tracking", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:src/hooks/useActiveSection.js:useActiveSection",
      "type": "function",
      "name": "useActiveSection",
      "filePath": "src/hooks/useActiveSection.js",
      "lineRange": [5, 27],
      "summary": "Observes the elements with the given ids using an IntersectionObserver limited to a middle band of the viewport, and returns the id of the section most recently crossing it. The observer is disconnected on cleanup.",
      "tags": ["hook", "intersection-observer", "navigation", "scroll-tracking"],
      "complexity": "simple"
    },
    {
      "id": "file:src/hooks/useGlowPointer.js",
      "type": "file",
      "name": "useGlowPointer.js",
      "filePath": "src/hooks/useGlowPointer.js",
      "summary": "Custom React hook module that drives the cursor-following glow on card borders by publishing pointer coordinates as CSS custom properties.",
      "tags": ["hook", "animation", "pointer-effects", "performance"],
      "complexity": "simple"
    },
    {
      "id": "function:src/hooks/useGlowPointer.js:useGlowPointer",
      "type": "function",
      "name": "useGlowPointer",
      "filePath": "src/hooks/useGlowPointer.js",
      "lineRange": [5, 31],
      "summary": "On fine-pointer devices, listens for pointer movement and sets card-relative --mx and --my variables on every on-screen .glow-card, throttled to one update per animation frame. Listeners and any pending frame are cleaned up on unmount.",
      "tags": ["hook", "event-handler", "animation", "performance", "pointer-effects"],
      "complexity": "simple",
      "languageNotes": "The requestAnimationFrame guard coalesces high-frequency pointer events, and the passive listener avoids blocking scrolling."
    }
  ],
